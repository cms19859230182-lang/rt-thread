    PKG + '/components/freertos/FreeRTOS-Kernel/portable/xtensa/include/freertos',
    # ESP-IDF's FreeRTOS API additions; only the declarations are needed, the
    # implementation is the fork's components/rtthread/scons/idf_additions_wrapper.c
    PKG + '/components/freertos/esp_additions/include',
