    PKG + '/components/freertos/config/include',
    PKG + '/components/freertos/config/include/freertos',
    PKG + '/components/freertos/config/xtensa/include',
    # esp_libc owns the newlib compatibility headers; it has to be searched
    # before the toolchain headers it wraps with #include_next.
    PKG + '/components/esp_libc/platform_include',
    PKG + '/components/heap/tlsf',
    # the per-chip SoC memprot headers live under esp_hw_support/include/soc/<target>
    PKG + '/components/esp_hw_support/include/soc/esp32s3',
    PKG + '/components/esp_system/port/include/private',
    PKG + '/components/esp_system/port/arch/xtensa',
    # nested per-SoC port directories: the include-dir scan above only walks
    # <component>/{,port/,<chip>,port/<chip>}, so component sub-directories that
    # own a port/<chip> tree (esp_hw_support/mspi/mspi_timing_tuning here, which
    # provides mspi_timing_tuning_configs.h) have to be listed explicitly.
    PKG + '/components/esp_hw_support/mspi/mspi_timing_tuning/port/esp32s3',
]

# Kept last on purpose: this is ESP-IDF's FreeRTOS V11 kernel copy, searched
# only for the two headers the FreeRTOS-Wrapper (V10.4.6) does not ship,
# <freertos/stream_buffer.h> and <freertos/message_buffer.h>, whose handle
# typedefs ESP-IDF's <freertos/idf_additions.h> uses.  The wrapper's own
# FreeRTOS headers must stay ahead of it on CPPPATH, or #include_next would hand
# <freertos/FreeRTOS.h> to the V11 copy instead; the ordering is set up by the
# BSP SConscript.  The scons FreeRTOS shims in components/rtthread/scons/include
# are prepended there for the same reason.
path.append(PKG + '/components/freertos/FreeRTOS-Kernel/include')

# libxt_hal.a supplies xthal_save/restore_extra_nw, xthal_window_spill_nw and
# the coprocessor save/restore used by libcpu/xtensa and xtensa_context.S. It is
# linked whole-archive via LINKFLAGS below: those helpers are reached only from
# the assembler-written context code, so the linker cannot see it needs them.

CPPDEFINES = [
    'IDF_VER=\\"999\\"',
    'PROJECT_VER=\\"999\\"',
    '_GNU_SOURCE',
    'MULTI_HEAP_FREERTOS',
    'ESP_PLATFORM=1',
    'IDF_TARGET=esp32s3',
    '_POSIX_READER_WRITER_LOCKS',
    'PROJECT_NAME=\\"rtthread\\"',
    '__ets__',
    # v6.1 moved CMD_WRAP into components/spi_flash/include/esp_flash_chips/
    # spi_flash_defs.h.  Same value as there; defined here as well so call
    # sites that use it without including that header still compile.
    'CMD_WRAP=0x77',
]


# No mbedTLS / tf-psa-crypto include roots.  This BSP builds no TLS stack, and
# the only file that used to pull in <psa/crypto.h> -
# components/bootloader_support/src/bootloader_sha.c - is not part of the set
# (see the file header).  Nothing in `src` includes a mbedtls header any more;
# if a future option brings the crypto port back, add the roots the C3/C6 BSPs
# pick up from the ESP-IDF package SConscript, in this same spot.

# ESP-IDF's CMake build folds every component's linker fragment into the final
# link line; the scons BSP carries its own sections.ld (see rtconfig.py LFLAGS),
# so the pieces v6.1 newly relies on are added here by hand.
_linker_scripts = []
# components/esp_hal_regi2c: the ROM regi2c implementation of this SoC. The
# fragment only exists for the targets that keep the ROM implementation.
_regi2c_ld = os.path.join(PKG, 'components/esp_hal_regi2c/esp32s3/rom.regi2c.ld')
if os.path.isfile(_regi2c_ld):
    _linker_scripts.append('-Wl,-T,' + _regi2c_ld)
# components/esp_libc: esp_rom_newlib_init_common_mutexes() lives in ROM and
# esp_libc/src/locks.c calls it during startup.
_rom_libc_ld = os.path.join(PKG, 'components/esp_rom/esp32s3/ld/esp32s3.rom.libc.ld')
if os.path.isfile(_rom_libc_ld):
    _linker_scripts.append('-Wl,-T,' + _rom_libc_ld)
LINKFLAGS = ' '.join([str(Env.get('LINKFLAGS', ''))] + _linker_scripts
                     + ['-L' + PKG + '/components/xtensa/esp32s3',
                        '-Wl,--whole-archive', '-lxt_hal', '-Wl,--no-whole-archive'])
Env['LINKFLAGS'] = LINKFLAGS

# Force-feed ATOMIC_VAR_INIT for toolchains whose <stdatomic.h> dropped it
# (esp_hw_support/esp_gpio_reserve.c, spi_bus_lock.c, spi_share_hw_ctrl.c
# still use it; GCC 15 no longer provides it under C17+), and clear
# CONFIG_ESP_IPC_ISR_ENABLE so esp_ipc_isr.h compiles its single-core no-op
# branch (see the header for why). Both are prepended, so they are seen before
# any other header of the translation unit.
LOCAL_CFLAGS = ' -include ' + cwd + '/include_compat/rtthread_ipc_isr_off.h' \
               ' -include ' + cwd + '/include_compat/atomic_var_init.h'

group = DefineGroup('esp-idf', src, depend = ['PKG_USING_ESP_IDF'],
                    CPPPATH = path, CPPDEFINES = CPPDEFINES,
                    LOCAL_CFLAGS = LOCAL_CFLAGS)

Return('group')
